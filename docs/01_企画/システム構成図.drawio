        </mxCell>

        <mxCell id="t3_state_label" value="クライアント状態 4 layer（= 業務 UI が画面に表示する状態の 4 段階分離管理）─ オフライン業務 / 楽観 lock / 競合解決を業務エンジニアが意識せず処理できるよう、状態を 4 layer に分離。tier2 SDK が組込み済み&#10;動機: 業務 UI で「保存ボタンを押した瞬間にネットが切れた」「他人が同時編集していた」等が頻発。4 layer で「即時反映 / 送信キュー / 競合検知 / 下書き保管」を分離、業務エンジニアは業務ロジックだけに集中" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="53" y="1250" width="3450" height="44" as="geometry" />
        </mxCell>
        <mxCell id="t3s1" value="layer 1: Server Truth&#10;サーバが正と認めた状態&#10;ETag + version vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="53" y="1304" width="419" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t3s2" value="layer 2: Optimistic Local&#10;ユーザ操作を即時画面反映（楽観反映）&#10;at-most-once-effective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="476" y="1304" width="419" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t3s3" value="layer 3: Pending Queue&#10;ネット断中の操作を蓄積、復帰時に再送&#10;Idempotency-Key 24h TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="901" y="1304" width="419" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t3s4" value="layer 4: Draft&#10;未送信の下書き（明示送信まで保管）&#10;ユーザ操作の起点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
