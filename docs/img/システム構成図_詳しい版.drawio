        <mxCell id="pg1_title" value="k1s0 の設計思想 ─ IT 担当者向け詳しい版" style="text;html=1;fontFamily=Helvetica;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
