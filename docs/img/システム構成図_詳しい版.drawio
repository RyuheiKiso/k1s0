        <mxCell id="pg1_l_t3" value="tier3（UI 層）&lt;br&gt;▶ 画面" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="116" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg1_r_t3" value="業務担当者が使う UI（Web SPA / デスクトップ exe / 旧 Windows アプリ）。業務語彙のみで開発。OSS を直接 import すると CI が自動拒否する。下の tier2 のみ呼び出し可能。" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="332" y="116" width="1438" height="90" as="geometry" />
        </mxCell>

        <!-- tier2 -->
        <mxCell id="pg1_l_t2" value="tier2（業務ドメイン）&lt;br&gt;▶ 業務共通化" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="216" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg1_r_t2" value="業界 pack が存在する層。業界共通ルール / atomic 三表書込 / 行レベルセキュリティ（RLS）を強制。業界固有語（製造 / ロット等）が混入すると命名禁則チェックで CI が機械的に拒否。" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="332" y="216" width="1438" height="90" as="geometry" />
        </mxCell>

        <!-- tier1 -->
        <mxCell id="pg1_l_t1" value="tier1（基盤実装）&lt;br&gt;▶ サーバ・SDK" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="316" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg1_r_t1" value="Rust / Go / C# / TypeScript の 4 言語 SDK。9 種の通信方式を透過的に切替え。13 の横断適合仕様を強制。L1+ OSS（PostgreSQL / Kafka / Temporal など）を単一深耕で使用（ベンダーロックイン回避のため 2 実装の適合仕様を維持）。" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="332" y="316" width="1438" height="90" as="geometry" />
        </mxCell>

        <!-- data -->
        <mxCell id="pg1_l_dt" value="data（データ管理）&lt;br&gt;▶ 状態・保管" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#333333;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="416" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg1_r_dt" value="PostgreSQL（業務記録）/ Kafka（変更の流れ）/ ClickHouse（監査ログ）/ Valkey（キャッシュ）。5 つの保管クラス。expand-contract 方式で無停止スキーマ変更。" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="332" y="416" width="1438" height="90" as="geometry" />
        </mxCell>

        <!-- infra -->
        <mxCell id="pg1_l_if" value="infra（動かす土台）&lt;br&gt;▶ 基盤・ポリシー" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="516" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg1_r_if" value="Kubernetes 上で動く。Kyverno（25+ ポリシー）で不正な操作を物理拒否。SPIRE/SPIFFE で ID 認証。HLC で分散時刻同期（GPS 基準）。Argo CD で設定変更を Git で管理・全記録。" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="332" y="516" width="1438" height="90" as="geometry" />
        </mxCell>

        <!-- 依存方向注記 -->
