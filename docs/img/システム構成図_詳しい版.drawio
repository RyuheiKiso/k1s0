        <mxCell id="pg1_pack_cross" value="業界横断層&lt;br&gt;&lt;br&gt;すべての業界で共通の機能:&lt;br&gt;通知 / 監査 / 承認ワークフロー&lt;br&gt;帳票 / マスタ管理&lt;br&gt;テナント識別子伝播" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
