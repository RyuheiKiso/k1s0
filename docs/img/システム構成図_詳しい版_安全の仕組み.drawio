        <!-- ① atomic 三表書込 -->
        <mxCell id="pg2_3t_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;" vertex="1" parent="1">
