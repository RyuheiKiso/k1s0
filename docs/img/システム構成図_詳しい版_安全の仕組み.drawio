        <mxCell id="pg2_arr34" value="" style="endArrow=classic;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;edgeStyle=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="217" as="sourcePoint" />
            <mxPoint x="1220" y="217" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- データ衝突帯 -->
        <mxCell id="pg2_conflict" value="データ衝突が起きたとき k1s0 が自動判別する 4 種のケース:&lt;br&gt;stale_write（古いデータで上書き）/ lost_update（自分の変更が他人に上書きされた）/ supersede（他人の編集を採用）/ concurrent_edit（同時編集）&lt;br&gt;いずれのケースも画面が自動判別し、業務担当者に適切な選択肢を提示する" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="312" width="1560" height="98" as="geometry" />
        </mxCell>

        <!-- ② Defense-in-depth 6 層 -->
        <mxCell id="pg2_dd_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="10" y="428" width="1580" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pg2_dd_hdr" value="② Defense-in-depth 6 層（文章・運用ルールに頼らない物理的強制）" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="436" width="1100" height="22" as="geometry" />
        </mxCell>
        <mxCell id="pg2_dd_note" value="文章や運用ルールに頼らない。6 層すべてで物理的に強制する。1 層が破れても他の層が必ず止める。" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="462" width="1560" height="22" as="geometry" />
        </mxCell>

        <!-- 6 層 -->
        <mxCell id="pg2_lay_a" value="A: コード生成時点で弾く&lt;br&gt;&lt;br&gt;型システムで不正な状態を表現不可能にする。コンパイルが通れば型不変条件は保証される。&lt;br&gt;&lt;br&gt;（中身: Rust phantom type / TS branded type / Go typestate / protoc + Buf）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="492" width="257" height="486" as="geometry" />
        </mxCell>
        <mxCell id="pg2_lay_b" value="B: 規約違反を自動拒否&lt;br&gt;&lt;br&gt;禁止依存・API drift・業界固有語の混入を CI で即拒否。push 前に自動検出する。&lt;br&gt;&lt;br&gt;（中身: cargo-deny / ESLint plugin-boundaries / Roslyn analyzer）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="281" y="492" width="257" height="486" as="geometry" />
        </mxCell>
        <mxCell id="pg2_lay_c" value="C: 結合点の動作を自動検証&lt;br&gt;&lt;br&gt;実際の DB / Kafka を使った統合テスト。カオス障害・境界テストも自動化。&lt;br&gt;&lt;br&gt;（中身: Pact / Testcontainers / Litmus chaos drill / Toxiproxy / AFL++）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="542" y="492" width="257" height="486" as="geometry" />
        </mxCell>
        <mxCell id="pg2_lay_d" value="D: 実行中も常に監視&lt;br&gt;&lt;br&gt;行レベルアクセス制御。重複リクエスト自動排除。障害時の自動遮断。JWTを毎リクエスト検証。&lt;br&gt;&lt;br&gt;（中身: PostgreSQL RLS / Idempotency-Key / circuit breaker / Keycloak + DPoP）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="803" y="492" width="257" height="486" as="geometry" />
        </mxCell>
        <mxCell id="pg2_lay_e" value="E: 署名のないコードは動かない&lt;br&gt;&lt;br&gt;未署名コードを Kubernetes が物理ブロック。暗号鍵は HSM が管理し漏洩不可能。&lt;br&gt;&lt;br&gt;（中身: Kyverno / Cosign / HSM PKCS#11 / Sigstore Rekor / Harbor）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1064" y="492" width="257" height="486" as="geometry" />
        </mxCell>
        <mxCell id="pg2_lay_f" value="F: 数学的に証明する&lt;br&gt;&lt;br&gt;TLA+ / Lean 4 などで仕様を形式証明。人間の見落としを数理的に排除する。&lt;br&gt;&lt;br&gt;（中身: TLA+ + Apalache / Dafny / Lean 4 + mathlib / Kani / CBMC）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#333333;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1325" y="492" width="255" height="486" as="geometry" />
        </mxCell>

        <!-- 凡例 -->
