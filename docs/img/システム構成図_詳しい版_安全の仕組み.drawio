        </mxCell>
        <mxCell id="pg2_title" value="k1s0 の安全保証の仕組み ─ IT 担当者向け詳しい版" style="text;html=1;fontFamily=Helvetica;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="16" width="1400" height="40" as="geometry" />
