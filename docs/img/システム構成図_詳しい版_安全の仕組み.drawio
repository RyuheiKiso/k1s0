        <mxCell id="pg2_3t_hdr" value="① atomic 三表書込（データ整合性の仕組み）" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="74" width="800" height="22" as="geometry" />
        </mxCell>
        <mxCell id="pg2_3t_note" value="業務データを変更するとき、3 か所のテーブルに同一トランザクション（atomic）で同時に書き込む。部分的な書き込み失敗は物理的に起きない。" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="1560" height="22" as="geometry" />
        </mxCell>

        <!-- 4 コンポーネント -->
        <mxCell id="pg2_state" value="① 業務記録の保管庫&lt;br&gt;（中身: PostgreSQL）&lt;br&gt;&lt;br&gt;業務の現在状態を保管。&lt;br&gt;行レベルセキュリティ（RLS）で&lt;br&gt;テナントをまたいだアクセス禁止。&lt;br&gt;pgaudit で全アクセスを記録" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="340" height="174" as="geometry" />
        </mxCell>
        <mxCell id="pg2_outbox" value="② 変更通知の配信&lt;br&gt;（中身: Kafka / Debezium CDC）&lt;br&gt;&lt;br&gt;変更を CDC でキャプチャし配信。&lt;br&gt;重複リクエストは 24 時間以内に&lt;br&gt;自動検出・無視する&lt;br&gt;（Idempotency-Key TTL）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="130" width="360" height="174" as="geometry" />
        </mxCell>
        <mxCell id="pg2_audit" value="③ 改ざん不可の監査ログ&lt;br&gt;（中身: ClickHouse + 外部公証）&lt;br&gt;&lt;br&gt;hash chain で改竄不能。&lt;br&gt;誰が・いつ・何を変更したかを&lt;br&gt;永久保存する。&lt;br&gt;RFC 3161 タイムスタンプで封印" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="130" width="360" height="174" as="geometry" />
        </mxCell>
        <mxCell id="pg2_hash" value="④ 監査鎖を外部公証で封印&lt;br&gt;（中身: RFC 3161 / Sigstore Rekor）&lt;br&gt;&lt;br&gt;外部公証サービスに記録し、&lt;br&gt;システム外からも検証可能。&lt;br&gt;組織内外を問わず&lt;br&gt;改竄が証明可能になる" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#333333;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="130" width="350" height="174" as="geometry" />
        </mxCell>

        <!-- 3 つの矢印（ラベルなし） -->
        <mxCell id="pg2_arr12" value="" style="endArrow=classic;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;edgeStyle=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="217" as="sourcePoint" />
            <mxPoint x="400" y="217" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pg2_arr23" value="" style="endArrow=classic;endFill=1;html=1;strokeColor=#333333;strokeWidth=2;edgeStyle=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="217" as="sourcePoint" />
