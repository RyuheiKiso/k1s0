        <mxCell id="legend_note" value="逆方向は CI 物理拒否（強制機構による）" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=2;fontColor=#333333;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
