<!--
  k1s0 tier1 Library C# プロジェクト定義
  05_鍵管理適合仕様.md / 04_認証適合仕様.md に基づく 4 言語等価強度 SDK の C# 実装
  NuGet パッケージとして配布可能にする（PackageId / Version を設定する）
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- .NET 8 ターゲットフレームワーク（LTS 版、4 言語等価強度の基準） -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Null 参照型の有効化（型安全性向上、null 非許容を明示する） -->
    <Nullable>enable</Nullable>
    <!-- 暗黙的 using の無効化（明示的 import を強制して依存を可視化する） -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 最新 C# 言語バージョンを使用する（required / record / init accessor 等） -->
    <LangVersion>latest</LangVersion>
    <!-- ルート名前空間: K1s0.Tier1 -->
    <RootNamespace>K1s0.Tier1</RootNamespace>
    <!-- アセンブリ名 -->
    <AssemblyName>k1s0.tier1.library</AssemblyName>
    <!-- NuGet パッケージ ID -->
    <PackageId>k1s0.Tier1.Library</PackageId>
    <!-- バージョン: 0.1.0（初期実装） -->
    <Version>0.1.0</Version>
    <!-- 説明: tier1 KeyHandle / AuthContext / Repository の C# 実装 -->
    <Description>k1s0 tier1 Library: KeyHandle / AuthContext / Repository (C# .NET 8)</Description>
    <!-- NuGet パッケージとして出力する -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- warnings-as-errors: 型安全性を強制する -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
