{
  "apalache_version": "0.45.4",
  "check": {
    "init": "InitState",
    "next": "Next",
    "invariants": ["TypeInvariant", "NoDoubleHandshake"],
    "length": 10,
    "tuning": {
      "search.smt.fp": "true",
      "smt.randomSeed": "42"
    }
