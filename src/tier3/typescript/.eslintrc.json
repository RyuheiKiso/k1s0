{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "import"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended-type-checked"
  ],
  "parserOptions": {
    "project": true
  },
  "rules": {
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "target": "./packages",
            "from": "../../tier1",
            "message": "tier3 から tier1 への直接 import を禁止する（tier2 SDK 経由必須）"
          },
          {
            "target": "./spa",
            "from": "../../tier1",
            "message": "tier3 SPA から tier1 への直接 import を禁止する（tier2 SDK 経由必須）。spa target の検出漏れ防止のため zones に追加する。"
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["*tier1*", "@tier1/*", "@k1s0/tier1-*"],
            "message": "tier3 から tier1 への直接 import を禁止する（tier2 SDK 経由必須）"
          },
          {
            "group": ["@k1s0/tier2-admin-*"],
            "message": "業務管理 API（tier2-admin）を tier3 業務 UI から直接 import 禁止"
          },
          {
            "group": ["*getAccessToken*", "*get_access_token*"],
            "message": "access_token getter の公開を禁止する（BFF cookie auth のみ）"
          },
          {
            "group": ["*/admin/*", "**/admin/**"],
            "message": "業務管理 API（admin 配下）を tier3 業務 UI から直接 import 禁止（tier2 SDK 経由必須）"
          }
        ]
      }
    ]
  }
}
