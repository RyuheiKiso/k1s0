{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "import"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended-type-checked"
  ],
  "parserOptions": {
    "project": true
  },
  "rules": {
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "target": "./packages",
            "from": "../../tier1",
            "message": "tier3 から tier1 への直接 import を禁止する（tier2 SDK 経由必須）"
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["*tier1*", "@tier1/*"],
            "message": "tier3 から tier1 への直接 import を禁止する"
          },
          {
            "group": ["*getAccessToken*", "*get_access_token*"],
            "message": "access_token getter の公開を禁止する（BFF cookie auth のみ）"
          }
        ]
      }
    ]
  }
}
