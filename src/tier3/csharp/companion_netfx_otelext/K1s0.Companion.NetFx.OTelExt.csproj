<?xml version="1.0" encoding="utf-8"?>
<!-- k1s0 Companion .NET Framework OTel 拡張 NuGet パッケージプロジェクト定義 -->
<!-- .NET Framework 4.6.2 ターゲット: WCF / HttpWebRequest / WebClient / HttpClient の 4 stack に対応する -->
<!-- CLR profiler hook インターフェースと JWT claim processor を含む -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ターゲットフレームワーク: .NET Framework 4.6.2（Legacy 対応要件） -->
    <TargetFramework>net462</TargetFramework>
    <!-- アセンブリ名: k1s0 NuGet 命名規約 -->
    <AssemblyName>K1s0.Companion.NetFx.OTelExt</AssemblyName>
    <!-- ルートネームスペース -->
    <RootNamespace>K1s0.Companion.NetFx.OTelExt</RootNamespace>
    <!-- NuGet パッケージ ID -->
    <PackageId>K1s0.Companion.NetFx.OTelExt</PackageId>
    <!-- パッケージバージョン -->
    <Version>1.0.0</Version>
    <!-- パッケージ作成者 -->
    <Authors>k1s0 team</Authors>
    <!-- パッケージ説明文 -->
    <Description>k1s0 .NET Framework 4.6.2 OpenTelemetry 拡張パッケージ — CLR profiler hooks + JWT claim OTel span injection</Description>
    <!-- パッケージタグ -->
    <PackageTags>opentelemetry;otlp;clr-profiler;jwt;k1s0</PackageTags>
    <!-- NuGet パッケージを生成する -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- nullable reference types を有効化する（.NET Framework でも警告として有効にする） -->
    <Nullable>enable</Nullable>
    <!-- 警告をエラーとして扱う（品質強制） -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- AssemblyInfo の自動生成を抑制する（手書き AssemblyInfo.cs が存在するため） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- LangVersion: C# 9 以上の構文を .NET Framework 4.6.2 で使用する -->
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenTelemetry コアライブラリ: ITracerProvider / ActivitySource に使用する -->
    <PackageReference Include="OpenTelemetry" Version="1.9.0" />
    <!-- OTLP exporter: gRPC / HTTP/protobuf によるデータエクスポートに使用する -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.9.0" />
    <!-- ASP.NET instrumentation: HttpWebRequest / WebClient のトレース計装に使用する -->
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <!-- JWT デコードライブラリ: Authorization ヘッダーから Bearer token を解析するために使用する -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.1" />
  </ItemGroup>

</Project>
