<?xml version="1.0" encoding="UTF-8"?>
<!--
  Product.wxs — WiX Toolset MSI project
  k1s0 Tier3 Desktop (WPF) インストーラ
  設計方針 31_配布デプロイ運用: WiX MSI 配布
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="k1s0 Tier3 Desktop"
    Language="1041"
    Version="1.0.0.0"
    Manufacturer="k1s0"
    UpgradeCode="12345678-1234-1234-1234-123456789ABC">

    <!-- インストーラパッケージを定義する -->
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <!-- アップグレード設定: 旧バージョンを自動削除する -->
    <MajorUpgrade DowngradeErrorMessage="新しいバージョンがインストール済みです。" />

    <!-- メディア定義: cab ファイルを MSI に埋め込む -->
    <MediaTemplate EmbedCab="yes" />

    <!-- インストール先ディレクトリ構造を定義する -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="k1s0 Tier3 Desktop">
          <!-- アプリケーション実行ファイルコンポーネントを定義する -->
          <Component Id="ApplicationFiles" Guid="*">
            <File Id="MainExecutable"
                  Source="$(var.ProjectDir)\bin\Release\net8.0-windows\k1s0.Tier3.Desktop.exe"
                  KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <!-- インストール機能を定義する -->
    <Feature Id="ProductFeature" Title="k1s0 Tier3 Desktop" Level="1">
      <!-- アプリケーションファイルコンポーネントを参照する -->
      <ComponentRef Id="ApplicationFiles" />
    </Feature>
  </Product>
</Wix>
