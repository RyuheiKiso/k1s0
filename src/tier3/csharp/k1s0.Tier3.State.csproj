<!-- k1s0 tier3 C# state lib（WPF .NET 8+ 等価強度実装） -->
<!-- 適合仕様 11_クライアント状態適合仕様.md の v1 layer セットに準拠する -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 8 ターゲット -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- null 安全性を厳格に強制する -->
    <Nullable>enable</Nullable>
    <!-- implicit using を有効にする -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 言語バージョン（C# 12） -->
    <LangVersion>12</LangVersion>
    <!-- アセンブリ名 -->
    <AssemblyName>k1s0.Tier3.State</AssemblyName>
    <!-- 名前空間 -->
    <RootNamespace>K1s0.Tier3.State</RootNamespace>
    <!-- バージョン -->
    <Version>0.1.0</Version>
    <!-- 説明 -->
    <Description>k1s0 tier3 4 layer client state（C# 等価強度実装）</Description>
    <!-- MSTest テストランナーを有効にする -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- MSTest フレームワーク参照を追加する -->
  <ItemGroup>
    <!-- MSTest テストフレームワーク -->
    <PackageReference Include="MSTest.TestFramework" Version="3.5.2" />
    <!-- MSTest テストアダプター（dotnet test で実行するため） -->
    <PackageReference Include="MSTest.TestAdapter" Version="3.5.2" />
    <!-- Microsoft.NET.Test.Sdk（テストホスト） -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- PublicApiAnalyzers: public API の変更を追跡して破壊的変更を CI で検出する -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
      <!-- analyzer のみとして参照する（runtime 依存なし） -->
      <PrivateAssets>all</PrivateAssets>
      <!-- ビルド資産を含める -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- PublicAPI ファイルを AdditionalFiles に追加する -->
  <ItemGroup>
    <!-- 出荷済み API の追跡ファイル（変更時は破壊的変更として CI が警告する） -->
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <!-- 未出荷 API の追跡ファイル（新規 public API を列挙する） -->
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- WPF App / WinForms サブプロジェクトの .cs を State lib のコンパイル対象から除外する -->
  <!-- wpf/ と legacy/winforms/ は独自の .csproj でビルドされるため二重コンパイル禁止 -->
  <ItemGroup>
    <!-- wpf/ 配下の WPF Application コードを除外する -->
    <Compile Remove="wpf\**\*.cs" />
    <!-- legacy/winforms/ 配下の WinForms コードを除外する -->
    <Compile Remove="legacy\winforms\**\*.cs" />
  </ItemGroup>

  <!-- k1s0-hlc C# 参照: wall-clock TTL 禁止規律に従い HLC を使用する -->
  <!-- src/CLAUDE.md §wall-clock TTL 禁止: DateTimeOffset.UtcNow を直接使う経路を排除する -->
  <ItemGroup>
    <!-- k1s0-hlc C# lib: HlcTimestamp / HlcClock を提供する（path 依存） -->
    <ProjectReference Include="..\..\client\hlc_lib\csharp\HlcLib\HlcLib.csproj" />
  </ItemGroup>

</Project>
