<!-- k1s0 tier3 C# state lib（WPF .NET 8+ 等価強度実装） -->
<!-- 適合仕様 11_クライアント状態適合仕様.md の v1 layer セットに準拠する -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 8 ターゲット -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- null 安全性を厳格に強制する -->
    <Nullable>enable</Nullable>
    <!-- implicit using を有効にする -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 言語バージョン（C# 12） -->
    <LangVersion>12</LangVersion>
    <!-- アセンブリ名 -->
    <AssemblyName>k1s0.Tier3.State</AssemblyName>
    <!-- 名前空間 -->
    <RootNamespace>K1s0.Tier3.State</RootNamespace>
    <!-- バージョン -->
    <Version>0.1.0</Version>
    <!-- 説明 -->
    <Description>k1s0 tier3 4 layer client state（C# 等価強度実装）</Description>
    <!-- MSTest テストランナーを有効にする -->
    <IsTestProject>true</IsTestProject>
    <!-- コード解析を全て有効化する（至高路線・R3-9） -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- 警告をエラーとして扱う（tier3 C# 規律統一） -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- MSTest フレームワーク参照を追加する -->
  <ItemGroup>
    <!-- MSTest テストフレームワーク -->
    <PackageReference Include="MSTest.TestFramework" Version="3.5.2" />
    <!-- MSTest テストアダプター（dotnet test で実行するため） -->
    <PackageReference Include="MSTest.TestAdapter" Version="3.5.2" />
    <!-- Microsoft.NET.Test.Sdk（テストホスト） -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <!-- WPF App / WinForms サブプロジェクトの .cs を State lib のコンパイル対象から除外する -->
  <!-- wpf/ と legacy/winforms/ は独自の .csproj でビルドされるため二重コンパイル禁止 -->
  <ItemGroup>
    <!-- wpf/ 配下の WPF Application コードを除外する -->
    <Compile Remove="wpf\**\*.cs" />
    <!-- legacy/winforms/ 配下の WinForms コードを除外する -->
    <Compile Remove="legacy\winforms\**\*.cs" />
    <!-- TransportSelector.cs は .NET Framework 4.6.2 専用（WinHttpHandler 依存）につき .NET 8 target から除外する -->
    <!-- k1s0.Tier3.Legacy.NetFx.csproj のみでビルドされる設計（cross-compile 禁止） -->
    <Compile Remove="legacy\TransportSelector.cs" />
  </ItemGroup>

  <!-- k1s0-hlc C# 参照: wall-clock TTL 禁止規律に従い HLC を使用する -->
  <!-- src/CLAUDE.md §wall-clock TTL 禁止: DateTimeOffset.UtcNow を直接使う経路を排除する -->
  <ItemGroup>
    <!-- k1s0-hlc C# lib: HlcTimestamp / HlcClock を提供する（path 依存） -->
    <ProjectReference Include="..\..\client\hlc_lib\csharp\HlcLib\HlcLib.csproj" />
    <!-- k1s0.Connect.NetCore: Connect-RPC クライアントスタック（tier3 C# → tier1 Bidi 接続用、R3-8） -->
    <ProjectReference Include="..\..\_crosscutting\13_dotnet8_connect_inhouse\lib\k1s0.Connect.NetCore.csproj" />
  </ItemGroup>

  <!-- 静的解析ツール（R3-9） -->
  <ItemGroup>
    <!-- 禁止 API 解析器: tier1 直接 import・raw token 露出を静的に検出する -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.11.0" />
    <!-- BannedSymbols.txt: WPF プロジェクトと共有する禁止シンボルリスト -->
    <AdditionalFiles Include="wpf\BannedSymbols.txt" />
  </ItemGroup>

</Project>
