<?xml version="1.0" encoding="utf-8"?>
<!-- k1s0 Connect-RPC .NET 8 conformance テストプロジェクト -->
<!-- xUnit を使って ConformanceSuite の全シナリオを検証する -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ターゲットフレームワーク: .NET 8 -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- nullable reference types を有効化する -->
    <Nullable>enable</Nullable>
    <!-- 暗黙的な using を有効化する -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LangVersion: C# 12 を使用する -->
    <LangVersion>12</LangVersion>
    <!-- テストプロジェクトであることを宣言する（dotnet test が認識する） -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit テストフレームワーク -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- xUnit テストランナー（Visual Studio / dotnet test 統合） -->
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <!-- ビルド出力には含めない -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <!-- プロジェクト参照には含めない -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Microsoft テストアダプター（dotnet test CLI で使用する） -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- ASP.NET Core TestServer: HTTP ハンドラーのインプロセステストに使用する -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト対象プロジェクトへの参照 -->
    <ProjectReference Include="..\K1s0.Connect.NetCore.csproj" />
  </ItemGroup>

</Project>
