<?xml version="1.0" encoding="utf-8"?>
<!-- k1s0 自製 Connect-RPC .NET 8 実装プロジェクト定義 -->
<!-- Connect-RPC wire format（5 byte framing）と ASP.NET Core エンドポイント handler を提供する -->
<!-- 4 RPC form: Unary / ServerStreaming / ClientStreaming / Bidi に対応する -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ターゲットフレームワーク: .NET 8（LTS） -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- アセンブリ名: k1s0 NuGet 命名規約 -->
    <AssemblyName>K1s0.Connect.NetCore</AssemblyName>
    <!-- ルートネームスペース -->
    <RootNamespace>K1s0.Connect.NetCore</RootNamespace>
    <!-- NuGet パッケージ ID -->
    <PackageId>K1s0.Connect.NetCore</PackageId>
    <!-- パッケージバージョン -->
    <Version>1.0.0</Version>
    <!-- パッケージ作成者 -->
    <Authors>k1s0 team</Authors>
    <!-- パッケージ説明文 -->
    <Description>k1s0 自製 Connect-RPC .NET 8 実装 — Connect wire format + ASP.NET Core handler + conformance suite</Description>
    <!-- パッケージタグ -->
    <PackageTags>connect-rpc;grpc;http2;k1s0;asp-net-core</PackageTags>
    <!-- NuGet パッケージを生成する -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- nullable reference types を有効化する -->
    <Nullable>enable</Nullable>
    <!-- 暗黙的な using を有効化する（.NET 8 推奨） -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LangVersion: C# 12 を使用する -->
    <LangVersion>12</LangVersion>
    <!-- warnings をエラーとして扱う -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core: エンドポイント handler の実装に使用する -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Google.Protobuf: protobuf シリアライズ / デシリアライズに使用する -->
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <!-- System.IO.Pipelines: 高性能バイト列処理（5 byte framing に使用する） -->
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
  </ItemGroup>

</Project>
