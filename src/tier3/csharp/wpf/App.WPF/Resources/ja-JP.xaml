<!-- k1s0 tier3 WPF 日本語リソース辞書 -->
<!-- tier3 packages/i18n の ja-JP.yaml と等価（locales/ja_JP.yaml の内容と一致させる）-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- アプリタイトル -->
    <sys:String x:Key="AppTitle">k1s0 業務管理</sys:String>
    <!-- ナビゲーション -->
    <sys:String x:Key="NavPlant">工場現場</sys:String>
    <sys:String x:Key="NavConflicts">コンフリクト解決</sys:String>
    <!-- PlantView -->
    <sys:String x:Key="PlantViewTitle">工場現場</sys:String>
    <sys:String x:Key="ServerTruthStatus">接続状態: 正常</sys:String>
    <!-- ConflictView -->
    <sys:String x:Key="ConflictViewTitle">コンフリクト解決</sys:String>
    <sys:String x:Key="ConflictStaleWriteMsg">古い書き込み検出: 自動 rebase を実行します</sys:String>
    <sys:String x:Key="ConflictLostUpdateMsg">更新の競合: 3方向マージが必要です</sys:String>
    <sys:String x:Key="ConflictSupersededMsg">操作が上書きされました</sys:String>
    <sys:String x:Key="ConflictConcurrentEditMsg">同時編集が検出されました: 続行または中止を選択してください</sys:String>
</ResourceDictionary>
