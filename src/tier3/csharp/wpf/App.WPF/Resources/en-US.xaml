<!-- k1s0 tier3 WPF English resource dictionary -->
<!-- tier3 packages/i18n の en-US.yaml と等価（locales/en_US.yaml の内容と一致させる）-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- App title -->
    <sys:String x:Key="AppTitle">k1s0 Business Management</sys:String>
    <!-- Navigation -->
    <sys:String x:Key="NavPlant">Plant Floor</sys:String>
    <sys:String x:Key="NavConflicts">Conflict Resolution</sys:String>
    <!-- PlantView -->
    <sys:String x:Key="PlantViewTitle">Plant Floor</sys:String>
    <sys:String x:Key="ServerTruthStatus">Connection Status: Normal</sys:String>
    <!-- ConflictView -->
    <sys:String x:Key="ConflictViewTitle">Conflict Resolution</sys:String>
    <sys:String x:Key="ConflictStaleWriteMsg">Stale write detected: auto-rebasing</sys:String>
    <sys:String x:Key="ConflictLostUpdateMsg">Update conflict: 3-way merge required</sys:String>
    <sys:String x:Key="ConflictSupersededMsg">Operation was superseded</sys:String>
    <sys:String x:Key="ConflictConcurrentEditMsg">Concurrent edit detected: continue or abort</sys:String>
</ResourceDictionary>
