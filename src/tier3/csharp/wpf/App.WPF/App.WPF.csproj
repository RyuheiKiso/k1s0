<!-- k1s0 tier3 WPF App プロジェクトファイル -->
<!-- .NET 8.0 + UseWPF=true。tier3 4 layer state を消費する Desktop exe -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- ターゲットフレームワーク: .NET 8.0-windows（WPF には windows 必須） -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- WPF を有効化する -->
    <UseWPF>true</UseWPF>
    <!-- Nullable 型アノテーションを有効化する -->
    <Nullable>enable</Nullable>
    <!-- アセンブリ名を設定する -->
    <AssemblyName>k1s0.Tier3.App.WPF</AssemblyName>
    <!-- ルート名前空間を設定する -->
    <RootNamespace>K1s0.Tier3.Wpf</RootNamespace>
    <!-- 出力タイプ: Windows アプリケーション（コンソール非表示）-->
    <OutputType>WinExe</OutputType>
    <!-- ImplicitUsings を有効化する -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 分析ツールを有効化する -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Microsoft.CodeAnalysis.BannedApiAnalyzers を有効化する -->
    <AnalysisMode>Default</AnalysisMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- tier3 State Library を参照する（tier2 SDK 経由のみ許可） -->
    <ProjectReference Include="..\..\k1s0.Tier3.State.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- BannedSymbols.txt: tier1 直接 import 禁止リストを継承する -->
    <AdditionalFiles Include="..\BannedSymbols.txt" />
  </ItemGroup>
</Project>
