<!-- k1s0 tier3 WPF コンフリクト解決 View -->
<!-- 11_クライアント状態適合仕様.md §4 subtype (stale_write / lost_update / supersede / concurrent_edit) 分岐 UI -->
<UserControl x:Class="K1s0.Tier3.Wpf.Views.ConflictView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="コンフリクト解決画面"
             AutomationProperties.HelpText="業務コンフリクト（stale_write/lost_update/supersede/concurrent_edit）の解決 UI">
    <!-- StackPanel: コンテンツ縦積みレイアウト -->
    <StackPanel Margin="16">
        <!-- 画面タイトル（a11y: Heading）-->
        <TextBlock Text="{DynamicResource ConflictViewTitle}"
                   FontSize="20" FontWeight="Bold"
                   AutomationProperties.HeadingLevel="1"/>
        <!-- SubType 表示エリア（4 subtype 分岐用 ContentPresenter）-->
        <ContentPresenter Content="{Binding ConflictSubType}"
                           AutomationProperties.Name="コンフリクト種別"
                           AutomationProperties.LiveSetting="Assertive"/>
        <!-- stale_write メッセージ -->
        <TextBlock Text="{DynamicResource ConflictStaleWriteMsg}"
                   Visibility="{Binding IsStaleWrite, Converter={StaticResource BoolToVisibility}}"/>
        <!-- lost_update: 3-way merge UI -->
        <TextBlock Text="{DynamicResource ConflictLostUpdateMsg}"
                   Visibility="{Binding IsLostUpdate, Converter={StaticResource BoolToVisibility}}"/>
        <!-- supersede: silent トースト相当 -->
        <TextBlock Text="{DynamicResource ConflictSupersededMsg}"
                   Visibility="{Binding IsSuperseded, Converter={StaticResource BoolToVisibility}}"/>
        <!-- concurrent_edit: user choice UI -->
        <TextBlock Text="{DynamicResource ConflictConcurrentEditMsg}"
                   Visibility="{Binding IsConcurrentEdit, Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel>
</UserControl>
