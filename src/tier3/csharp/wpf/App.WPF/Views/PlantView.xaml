<!-- k1s0 tier3 WPF 工場現場 View -->
<!-- tier3 ServerTruth layer のデータを表示する製造現場 UI -->
<UserControl x:Class="K1s0.Tier3.Wpf.Views.PlantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="工場現場画面"
             AutomationProperties.HelpText="工場の検査記録・発注状態を表示する">
    <!-- StackPanel: コンテンツ縦積みレイアウト -->
    <StackPanel Margin="16">
        <!-- 画面タイトル（a11y: Heading）-->
        <TextBlock Text="{DynamicResource PlantViewTitle}"
                   FontSize="20" FontWeight="Bold"
                   AutomationProperties.HeadingLevel="1"/>
        <!-- 状態インジケータ（ServerTruth layer の接続状態）-->
        <TextBlock Text="{DynamicResource ServerTruthStatus}"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
