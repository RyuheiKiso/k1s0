<!-- k1s0 tier3 WPF .NET 8+ stub プロジェクト -->
<!-- 適合仕様: tier3 Desktop = C# WPF（.NET 8+）に準拠する -->
<!-- src/tier3/CLAUDE.md 「Desktop: C# WPF（.NET 8+）/ Rust + Tauri」に準拠する -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 8 Windows ターゲット（WPF は Windows のみ）-->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- WPF を有効にする（UseWPF=true で PresentationCore 等を自動参照する）-->
    <UseWPF>true</UseWPF>
    <!-- null 安全性を厳格に強制する -->
    <Nullable>enable</Nullable>
    <!-- implicit using を有効にする -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 言語バージョン（C# 12）-->
    <LangVersion>12</LangVersion>
    <!-- 出力タイプ: WinExe（ウィンドウアプリとしてビルドする）-->
    <OutputType>WinExe</OutputType>
    <!-- アセンブリ名 -->
    <AssemblyName>k1s0.Tier3.Wpf</AssemblyName>
    <!-- 名前空間 -->
    <RootNamespace>K1s0.Tier3.Wpf</RootNamespace>
    <!-- バージョン -->
    <Version>1.0.0</Version>
    <!-- 説明 -->
    <Description>k1s0 tier3 WPF デスクトップアプリケーション（.NET 8 Windows）</Description>
    <!-- Deterministic ビルドを有効にする -->
    <Deterministic>true</Deterministic>
    <!-- StartupObject: エントリポイントクラスを指定する -->
    <StartupObject>K1s0.Tier3.Wpf.App</StartupObject>
  </PropertyGroup>

  <!-- ソースファイル（stub 実装）-->
  <ItemGroup>
    <!-- App.xaml: WPF アプリケーション定義 -->
    <ApplicationDefinition Include="App.xaml">
      <!-- ビルドアクションを Page に設定する -->
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <!-- MainWindow.xaml: メインウィンドウ -->
    <Page Include="MainWindow.xaml">
      <!-- ビルドアクションを Page に設定する -->
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

</Project>
