<!--
  k1s0 tier3 WPF メインウィンドウ stub（MainWindow.xaml）
  WCAG 2.1 AA: AutomationProperties.Name で UI オートメーション名を設定する
  tier3 Desktop 適合仕様に準拠するスケルトン実装
-->
<Window
    x:Class="K1s0.Tier3.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="k1s0 Tier3 Desktop"
    Height="600"
    Width="900"
    MinHeight="480"
    MinWidth="640"
    WindowStartupLocation="CenterScreen">

    <!-- ウィンドウ全体のグリッドレイアウト -->
    <Grid>
        <!-- 行定義: ヘッダ / メインコンテンツ / ステータスバー -->
        <Grid.RowDefinitions>
            <!-- ヘッダ行（自動高さ）-->
            <RowDefinition Height="Auto" />
            <!-- メインコンテンツ行（残りのスペースを使用する）-->
            <RowDefinition Height="*" />
            <!-- ステータスバー行（自動高さ）-->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダ領域: アプリタイトルを表示する -->
        <Border
            Grid.Row="0"
            Background="#1E3A5F"
            Padding="16,8">
            <!-- ヘッダラベル -->
            <Label
                Content="k1s0 Tier3 Desktop"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                AutomationProperties.Name="アプリケーションタイトル" />
        </Border>

        <!-- メインコンテンツ領域: 中央にウェルカムメッセージを表示する -->
        <StackPanel
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Margin="24">
            <!-- ウェルカムメッセージ（TextBlock はスクリーンリーダーが読み上げる）-->
            <TextBlock
                Text="k1s0 Tier3 WPF Desktop アプリケーション"
                FontSize="20"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                AutomationProperties.Name="ウェルカムメッセージ" />
            <!-- 説明テキスト -->
            <TextBlock
                Text="このウィンドウは tier3 WPF stub 実装です。実際の業務 UI はここに実装します。"
                FontSize="14"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                Foreground="#555555"
                AutomationProperties.Name="アプリケーション説明" />
        </StackPanel>

        <!-- ステータスバー: アプリケーション状態を表示する -->
        <StatusBar
            Grid.Row="2"
            AutomationProperties.Name="ステータスバー">
            <!-- ステータスアイテム: 接続状態を表示する -->
            <StatusBarItem
                AutomationProperties.Name="接続状態">
                <!-- 接続状態テキスト -->
                <TextBlock Text="準備完了" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
