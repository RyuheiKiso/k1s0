<!-- k1s0 tier3 Legacy .NET Framework 4.6.2+ stub プロジェクト -->
<!-- 適合仕様: tier3 Desktop Legacy = .NET Framework 4.6.2+（WinForms / WPF 等価強度）-->
<!-- src/tier3/CLAUDE.md 「Legacy: .NET Framework 4.6.2+（WinForms / WPF）」に準拠する -->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- .NET Framework 4.6.2 ターゲット（Legacy 適合仕様の最低バージョン）-->
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <!-- .NET Framework プロジェクトのデフォルト ToolsVersion を使用する -->
    <ProductVersion>8.0.30703</ProductVersion>
    <!-- スキーマバージョン（.NET Framework プロジェクト標準）-->
    <SchemaVersion>2.0</SchemaVersion>
    <!-- プロジェクト GUID（Legacy .NET Framework プロジェクトに必須）-->
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <!-- 出力タイプ: クラスライブラリ（WinForms / WPF ホストから参照する）-->
    <OutputType>Library</OutputType>
    <!-- アセンブリ名 -->
    <AssemblyName>k1s0.Tier3.Legacy.NetFx</AssemblyName>
    <!-- 名前空間 -->
    <RootNamespace>K1s0.Tier3.Legacy</RootNamespace>
    <!-- バージョン -->
    <FileAlignment>512</FileAlignment>
    <!-- WarningLevel: コンパイラ警告レベルを最大に設定する -->
    <WarningLevel>4</WarningLevel>
    <!-- .NET Framework 参照アセンブリのパスを指定する -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Deterministic ビルドを有効にする -->
    <Deterministic>true</Deterministic>
    <!-- treat warnings as errors: 至高路線で false は規律低下のため true を強制する -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 標準 .NET Framework 参照アセンブリ -->
  <ItemGroup>
    <!-- System: 基本型 / 例外 / IO に使用する -->
    <Reference Include="System" />
    <!-- System.Core: LINQ / Task に使用する -->
    <Reference Include="System.Core" />
    <!-- System.Xml: XML 処理に使用する -->
    <Reference Include="System.Xml" />
    <!-- System.Xml.Linq: XDocument に使用する -->
    <Reference Include="System.Xml.Linq" />
    <!-- System.Data: DataSet / DataTable に使用する（帳票 / CSV 出力で使用する）-->
    <Reference Include="System.Data" />
    <!-- System.Net.Http: HttpClient に使用する（BFF 通信で使用する）-->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- ソースファイル（stub 実装）-->
  <ItemGroup>
    <!-- Legacy 添付ファイルヘルパー stub -->
    <Compile Include="LegacyAttachmentHelper.cs" />
  </ItemGroup>

</Project>
