<!-- nuget.config — NuGet パッケージソース設定（tier3 C# WPF / Legacy / contract プロジェクト） -->
<!-- 強制機構: docs/04_詳細設計/02_強制機構/03_tier3強制機構.md 層 12: 内部レジストリ唯一化 -->
<!-- 全 NuGet パッケージを内部 feed 経由のみで取得する（公開 nuget.org を排除）         -->
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 公開 nuget.org を明示的に無効化する（内部 feed のみを取得元にするために必須）-->
    <clear />
    <!-- 内部 NuGet feed を唯一のパッケージソースとして登録する -->
    <add key="k1s0-internal" value="https://nuget.k1s0.internal/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- 全パッケージを内部 feed から取得するよう強制する（外部 feed フォールバックを禁止）-->
    <packageSource key="k1s0-internal">
      <!-- ワイルドカードで全パッケージを内部 feed に固定する -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <activePackageSource>
    <!-- アクティブソースを内部 feed に設定する -->
    <add key="k1s0-internal" value="https://nuget.k1s0.internal/v3/index.json" />
  </activePackageSource>
</configuration>
