<!-- k1s0 Connect-RPC .NET 8 inhouse 実装のプロジェクトファイル -->
<!-- Connect Conformance Suite 全 case green を目標とする inhouse 実装ライブラリ -->
<Project Sdk="Microsoft.NET.Sdk">

  <!-- プロジェクト基本設定 -->
  <PropertyGroup>
    <!-- ターゲットフレームワーク: .NET 8.0 を使用する -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- アセンブリ名: k1s0.Connect.NetCore -->
    <AssemblyName>k1s0.Connect.NetCore</AssemblyName>
    <!-- ルート名前空間: K1s0.Connect.NetCore -->
    <RootNamespace>K1s0.Connect.NetCore</RootNamespace>
    <!-- NuGet パッケージ ID -->
    <PackageId>k1s0.Connect.NetCore</PackageId>
    <!-- バージョン: 0.1.0 -->
    <Version>0.1.0</Version>
    <!-- 作者情報 -->
    <Authors>k1s0</Authors>
    <!-- 説明: Connect-RPC .NET 8 inhouse 実装 -->
    <Description>k1s0 Connect-RPC .NET 8 inhouse 実装。Conformance Suite 全 case green を目標とする</Description>
    <!-- C# バージョン: 12 を使用する (.NET 8 推奨) -->
    <LangVersion>12</LangVersion>
    <!-- nullable 参照型を有効化する -->
    <Nullable>enable</Nullable>
    <!-- ImplicitUsings を有効化する (.NET 8 では標準的) -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメント XML ファイルを生成する -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AOT 互換性を有効化する -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet パッケージ依存関係 -->
  <ItemGroup>
    <!-- Google Protobuf: Protocol Buffers シリアライズに使用する -->
    <PackageReference Include="Google.Protobuf" Version="3.27.0" />
    <!-- Grpc.AspNetCore: gRPC / Connect-RPC サーバー実装に使用する -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.63.0" />
    <!-- Grpc.AspNetCore.Web: gRPC-Web 対応に使用する -->
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.63.0" />
    <!-- Microsoft.AspNetCore.SignalR.Client: WebSocket ストリーミングに使用する -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <!-- System.IO.Pipelines: 高パフォーマンス I/O に使用する -->
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
    <!-- Microsoft.Extensions.Http: HttpClient ファクトリに使用する -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

</Project>
