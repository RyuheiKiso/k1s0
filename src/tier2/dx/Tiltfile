# tier2 開発者体験: Tilt 開発環境定義（設計方針 27）
# tier2 サービス群（postgres / kafka / tier2-api）を統合的に起動する

# Tilt バージョン要件（v0.33 以上を要求する）
version_settings(constraint=">=0.33.0")

# 開発環境設定（production / development 区別禁止規約のため、セキュリティ・RLS・audit を弱体化しない）

# PostgreSQL サービスの起動定義
k8s_yaml([
    # PostgreSQL の Kubernetes マニフェストを読み込む
    "devcontainer/k8s/postgres.yaml",
])

# Kafka サービスの起動定義
k8s_yaml([
    # Kafka の Kubernetes マニフェストを読み込む
    "devcontainer/k8s/kafka.yaml",
])

# tier2-api の Docker ビルドおよびデプロイ定義
docker_build(
    # イメージ名（Harbor レジストリのパスと合わせる）
    "harbor.k1s0.internal/k1s0/tier2",
    # ビルドコンテキスト（tier2 ソースルート）
    ".",
    # Dockerfile のパス
    dockerfile="devcontainer/Dockerfile",
    # ライブリロード対象ファイルの変更を監視する
    live_update=[
        # Rust ソースコードの変更を検知してリビルドする
        sync("src", "/app/src"),
    ],
)

# tier2-api の Kubernetes マニフェストを読み込む
k8s_yaml(["devcontainer/k8s/tier2-api.yaml"])

# tier2-api リソースのポートフォワード設定（ローカル 8080 → コンテナ 8080）
k8s_resource(
    # リソース名
    "tier2-api",
    # ポートフォワード設定（ローカルポート:コンテナポート）
    port_forwards=["8080:8080"],
    # 依存サービス（postgres と kafka が起動してから tier2-api を起動する）
    resource_deps=["postgres", "kafka"],
)
