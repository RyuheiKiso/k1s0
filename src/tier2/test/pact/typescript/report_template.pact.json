{
  "consumer": {"name": "tier2-typescript-consumer"},
  "provider": {"name": "tier2-report-template-provider"},
  "interactions": [
    {
      "description": "report_template の TypeScript consumer contract",
      "providerState": "report template available",
      "request": {
        "method": "POST",
        "path": "/reports/v1/templates/render",
        "headers": {"Content-Type": "application/json"},
        "body": {"template_id": "test-template", "locale": "ja-JP", "data": {}}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {"rendered_content": "test-content", "mime_type": "application/pdf"}
      }
    }
  ],
  "metadata": {"pactSpecification": {"version": "3.0.0"}}
}
