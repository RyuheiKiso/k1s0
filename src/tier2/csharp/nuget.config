<?xml version="1.0" encoding="utf-8"?>
<!-- tier2 NuGet 設定: 内部パッケージソースを設定する -->
<configuration>
  <!-- NuGet パッケージソース設定 -->
  <packageSources>
    <!-- 内部 NuGet フィード (承認済みパッケージのみ) -->
    <add key="k1s0-internal" value="https://placeholder.internal.k1s0.io/v3/index.json" />
    <!-- nuget.org はフォールバックとして残す -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
