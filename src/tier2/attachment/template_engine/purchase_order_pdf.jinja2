{#- purchase_order_pdf.jinja2 — 発注書 PDF Jinja2 テンプレート -#}
{#- docs 参照: docs/03_概要設計/03_tier2設計方針/README.md §帳票生成 -#}
{#- docs 参照: src/tier2/extension_points.yaml § report_template -#}
{#- PII フィールドは render 前に redact すること（field_pii annotation 参照）-#}
{#- 変数一覧:
    - tenant_name: テナント名称（文字列）
    - order: 発注書オブジェクト（以下のフィールドを持つ）
        - order_id: 発注書識別子（UUID v7 形式）
        - order_number: 発注書番号（人間可読のビジネスキー）
        - placed_at: 発注日時（HLC タイムスタンプ文字列）
        - supplier.name: 仕入先名称
        - supplier.address: 仕入先住所（PII: render 前に redact 済みであること）
        - requester_name: 依頼者名（PII: render 前に redact 済みであること）
        - line_items: 発注明細行リスト（item_name / quantity / unit_price_milli / currency_code）
        - total_milli: 発注合計金額（ミリ通貨単位）
        - currency_code: 通貨コード（ISO 4217）
        - approval_status: 承認ステータス（PENDING / APPROVED / REJECTED）
        - approved_at: 承認日時（承認済みの場合のみ。HLC タイムスタンプ文字列）
        - approver_names: 承認者名リスト（PII: render 前に redact 済みであること）
    - generated_at: 帳票生成日時（HLC タイムスタンプ文字列）
    - doc_version: テンプレートバージョン（例: "1.0.0"）
-#}
<!DOCTYPE html>
<html lang="ja">
<head>
  {#- HTML ヘッダ: 文字コードと CSS スタイルを定義する -#}
  <meta charset="UTF-8">
  {#- PDF 出力用ページタイトル -#}
  <title>発注書 {{ order.order_number }}</title>
  <style>
    {#- 全体レイアウト: A4 サイズ相当のマージンを設定する -#}
    body { font-family: "Noto Sans JP", "IPAexGothic", sans-serif; margin: 20mm; font-size: 10pt; }
    {#- ヘッダエリア: 発注書タイトルと基本情報を配置する -#}
    .header { display: flex; justify-content: space-between; margin-bottom: 8mm; }
    {#- タイトル文字スタイル -#}
    .title { font-size: 18pt; font-weight: bold; }
    {#- メタ情報エリア: 発注番号・日付・テナント名を右寄せで表示する -#}
    .meta { text-align: right; font-size: 9pt; color: #555; }
    {#- 発注先・依頼者情報のセクション -#}
    .parties { display: flex; justify-content: space-between; margin-bottom: 6mm; }
    {#- 明細テーブルのスタイル -#}
    table { width: 100%; border-collapse: collapse; margin-bottom: 6mm; }
    {#- テーブルヘッダのスタイル -#}
    th { background-color: #f0f0f0; border: 1px solid #ccc; padding: 2mm 3mm; text-align: center; }
    {#- テーブルセルのスタイル -#}
    td { border: 1px solid #ccc; padding: 2mm 3mm; }
    {#- 金額セルは右寄せにする -#}
    td.amount { text-align: right; }
    {#- 合計行のスタイル -#}
    .total-row { font-weight: bold; background-color: #f8f8f8; }
    {#- フッタエリア: 承認情報と生成日時を配置する -#}
    .footer { margin-top: 8mm; font-size: 8pt; color: #777; border-top: 1px solid #ccc; padding-top: 3mm; }
    {#- 承認スタンプエリア -#}
    .approval-stamp { margin-top: 6mm; display: flex; gap: 10mm; }
    {#- スタンプボックスのスタイル -#}
    .stamp-box { border: 1px solid #999; padding: 3mm 5mm; width: 40mm; text-align: center; min-height: 15mm; }
  </style>
</head>
<body>
  {#- ヘッダエリア: タイトルと基本情報 -#}
  <div class="header">
    {#- 発注書タイトル -#}
    <div class="title">発 注 書</div>
    {#- 右上: 発注書番号・日付・テナント名 -#}
    <div class="meta">
      {#- 発注書番号 -#}
      <div>発注書番号: {{ order.order_number }}</div>
      {#- 発注日時（HLC タイムスタンプを表示用にフォーマットする）-#}
      <div>発注日時: {{ order.placed_at }}</div>
      {#- テナント名称 -#}
      <div>テナント: {{ tenant_name }}</div>
    </div>
  </div>

  {#- 発注先・依頼者情報エリア -#}
  <div class="parties">
    {#- 発注先（仕入先）情報 -#}
    <div class="supplier">
      <div><strong>発注先</strong></div>
      {#- 仕入先名称 -#}
      <div>{{ order.supplier.name }}</div>
      {#- 仕入先住所（PII: render 前に redact 済みであること）-#}
      <div>{{ order.supplier.address }}</div>
    </div>
    {#- 依頼者情報 -#}
    <div class="requester">
      <div><strong>依頼者</strong></div>
      {#- 依頼者名（PII: render 前に redact 済みであること）-#}
      <div>{{ order.requester_name }}</div>
    </div>
  </div>

  {#- 明細テーブル -#}
  <table>
    <thead>
      <tr>
        {#- 明細テーブルのヘッダ行 -#}
        <th>No.</th>
        <th>品目名称</th>
        <th>数量</th>
        <th>単価</th>
        <th>金額</th>
      </tr>
    </thead>
    <tbody>
      {#- 発注明細行をループで出力する -#}
      {% for item in order.line_items %}
      <tr>
        {#- 行番号（1 始まり）-#}
        <td>{{ loop.index }}</td>
        {#- 品目名称（業界中立の汎用名称）-#}
        <td>{{ item.item_name }}</td>
        {#- 数量 -#}
        <td class="amount">{{ item.quantity }}</td>
        {#- 単価（ミリ通貨単位を通常単位に変換して表示する）-#}
        <td class="amount">{{ (item.unit_price_milli / 1000) | round(2) }} {{ item.currency_code }}</td>
        {#- 行金額（数量 × 単価）-#}
        <td class="amount">{{ (item.quantity * item.unit_price_milli / 1000) | round(2) }} {{ item.currency_code }}</td>
      </tr>
      {% endfor %}
    </tbody>
    {#- 合計行 -#}
    <tfoot>
      <tr class="total-row">
        {#- 合計ラベルは 4 列にわたって表示する -#}
        <td colspan="4" class="amount"><strong>合計</strong></td>
        {#- 合計金額（ミリ通貨単位を通常単位に変換する）-#}
        <td class="amount"><strong>{{ (order.total_milli / 1000) | round(2) }} {{ order.currency_code }}</strong></td>
      </tr>
    </tfoot>
  </table>

  {#- 承認情報エリア -#}
  <div class="approval-stamp">
    {#- 承認ステータスを表示する -#}
    <div>
      <div><strong>承認ステータス</strong></div>
      {#- 承認済みの場合は承認日時と承認者を表示する -#}
      {% if order.approval_status == 'APPROVED' %}
        <div>承認済み</div>
        {#- 承認日時 -#}
        <div>{{ order.approved_at }}</div>
      {#- 未承認の場合は PENDING と表示する -#}
      {% elif order.approval_status == 'PENDING' %}
        <div>承認待ち</div>
      {#- 否認の場合は REJECTED と表示する -#}
      {% else %}
        <div>否認</div>
      {% endif %}
    </div>
    {#- 承認者印欄（承認者名リストをスタンプボックスで表示する）-#}
    {% for approver in order.approver_names %}
    <div class="stamp-box">
      {#- 承認者名（PII: render 前に redact 済みであること）-#}
      <div>{{ approver }}</div>
      <div style="font-size:7pt; margin-top:2mm;">承認</div>
    </div>
    {% endfor %}
  </div>

  {#- フッタエリア: 帳票生成情報 -#}
  <div class="footer">
    {#- 帳票生成日時と識別子を表示する -#}
    <div>帳票生成日時: {{ generated_at }} / テンプレートバージョン: {{ doc_version }} / 発注書 ID: {{ order.order_id }}</div>
    {#- 自動生成注記 -#}
    <div>本帳票は k1s0 tier2 帳票エンジンにより自動生成されました。</div>
  </div>
</body>
</html>
