<?xml version="1.0" encoding="UTF-8"?>
<!-- tier2 承認ワークフローの BPMN 2.0 プロセス定義 -->
<!-- 業界中立語のみ使用する（業界固有語禁止規約準拠） -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="k1s0.tier2.bpmn"
             id="approval_workflow_definitions">

  <!-- 承認プロセスの定義 -->
  <process id="approval_process" name="ApprovalWorkflow" isExecutable="true">

    <!-- プロセス開始イベント -->
    <startEvent id="start_event" name="申請受付">
      <!-- 申請受付完了後に承認依頼タスクへ遷移する -->
      <outgoing>flow_to_review</outgoing>
    </startEvent>

    <!-- 担当者による内容確認タスク -->
    <userTask id="task_review" name="内容確認">
      <!-- 確認完了後に承認判断ゲートウェイへ遷移する -->
      <incoming>flow_to_review</incoming>
      <outgoing>flow_to_gateway</outgoing>
    </userTask>

    <!-- 承認 / 却下の排他ゲートウェイ -->
    <exclusiveGateway id="gateway_decision" name="承認判断">
      <!-- 承認ルートと却下ルートに分岐する -->
      <incoming>flow_to_gateway</incoming>
      <outgoing>flow_approved</outgoing>
      <outgoing>flow_rejected</outgoing>
    </exclusiveGateway>

    <!-- 承認後の完了処理タスク -->
    <serviceTask id="task_approve" name="承認完了処理">
      <!-- 承認完了通知を Outbox 経由で送出する -->
      <incoming>flow_approved</incoming>
      <outgoing>flow_to_end_approved</outgoing>
    </serviceTask>

    <!-- 却下後の通知タスク -->
    <serviceTask id="task_reject" name="却下通知処理">
      <!-- 却下通知を Outbox 経由で送出する -->
      <incoming>flow_rejected</incoming>
      <outgoing>flow_to_end_rejected</outgoing>
    </serviceTask>

    <!-- 承認完了終了イベント -->
    <endEvent id="end_approved" name="承認完了">
      <incoming>flow_to_end_approved</incoming>
    </endEvent>

    <!-- 却下終了イベント -->
    <endEvent id="end_rejected" name="却下完了">
      <incoming>flow_to_end_rejected</incoming>
    </endEvent>

    <!-- 開始から内容確認タスクへのシーケンスフロー -->
    <sequenceFlow id="flow_to_review" sourceRef="start_event" targetRef="task_review"/>
    <!-- 内容確認タスクから承認判断ゲートウェイへのシーケンスフロー -->
    <sequenceFlow id="flow_to_gateway" sourceRef="task_review" targetRef="gateway_decision"/>
    <!-- 承認ルートのシーケンスフロー（conditionExpression: approved == true） -->
    <sequenceFlow id="flow_approved" sourceRef="gateway_decision" targetRef="task_approve">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <!-- 却下ルートのシーケンスフロー（conditionExpression: approved == false） -->
    <sequenceFlow id="flow_rejected" sourceRef="gateway_decision" targetRef="task_reject">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <!-- 承認完了処理から終了イベントへのシーケンスフロー -->
    <sequenceFlow id="flow_to_end_approved" sourceRef="task_approve" targetRef="end_approved"/>
    <!-- 却下通知処理から終了イベントへのシーケンスフロー -->
    <sequenceFlow id="flow_to_end_rejected" sourceRef="task_reject" targetRef="end_rejected"/>

  </process>
</definitions>
