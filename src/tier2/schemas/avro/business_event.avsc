{
  "namespace": "k1s0.tier2.schemas",
  "type": "record",
  "name": "BusinessEvent",
  "doc": "tier2 業務イベントの Avro スキーマ定義（全テナント共通）",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "doc": "イベント一意識別子（UUID v4 文字列表現）"
    },
    {
      "name": "tenant_id",
      "type": "string",
      "doc": "テナント識別子（UUID v4 文字列表現 / RLS 述語の基底）"
    },
    {
      "name": "aggregate_type",
      "type": "string",
      "doc": "集約型名（業界中立語のみ使用可。例: Resource / Entity / Process）"
    },
    {
      "name": "event_type",
      "type": "string",
      "doc": "イベント種別名（Outbox 経由でのみ emit される）"
    },
    {
      "name": "payload",
      "type": "bytes",
      "doc": "イベントペイロード（JSON バイト列 / PII フィールドは emit 前に redact 済み）"
    },
    {
      "name": "hlc_timestamp",
      "type": "long",
      "doc": "HLC タイムスタンプ（wall clock TTL 禁止規約により HLC を使用）"
    }
  ]
}
