{
  "_comment": "inspection_result.recorded.v1.avsc — quality aggregate の InspectionResult.Recorded ドメインイベント Avro スキーマ",
  "_doc_ref": "docs/03_概要設計/03_tier2設計方針/10_表現手段.md §Avro スキーマ / aggregate split",
  "type": "record",
  "name": "InspectionResultRecorded",
  "namespace": "io.k1s0.tier2.manufacturing.quality.inspection_result.v1",
  "doc": "検査結果（InspectionResult）が記録された（Recorded）ドメインイベント。quality aggregate の namespace を使用する。",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "イベント識別子（UUID v7 形式）"
    },
    {
      "name": "tenant_id",
      "type": "string",
      "doc": "テナント識別子（RLS 境界を保証する。AuthContext から取得する）"
    },
    {
      "name": "aggregate_id",
      "type": "string",
      "doc": "検査結果 aggregate の識別子（UUID v7 形式）"
    },
    {
      "name": "aggregate_version",
      "type": "long",
      "doc": "楽観的ロック用 aggregate バージョン番号（単調増加）"
    },
    {
      "name": "production_batch_id",
      "type": "string",
      "doc": "検査対象の生産バッチ識別子（UUID v7 形式）"
    },
    {
      "name": "inspector_id",
      "type": "string",
      "doc": "検査担当者の識別子（AuthContext.user_id）"
    },
    {
      "name": "verdict",
      "type": {
        "type": "enum",
        "name": "InspectionVerdict",
        "doc": "合否判定結果の列挙型",
        "symbols": ["PASS", "FAIL", "REQUIRES_REVIEW"]
      },
      "doc": "検査合否判定（PASS / FAIL / REQUIRES_REVIEW のいずれか）"
    },
    {
      "name": "measurement_items",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "MeasurementItem",
          "doc": "個別測定項目（項目名・測定値・合否を保持する）",
          "fields": [
            {
              "name": "item_name",
              "type": "string",
              "doc": "測定項目名（業界中立の汎用名称を使用する）"
            },
            {
              "name": "measured_value",
              "type": "double",
              "doc": "測定値（浮動小数点数）"
            },
            {
              "name": "unit",
              "type": "string",
              "doc": "単位（SI 単位系を推奨する）"
            },
            {
              "name": "within_spec",
              "type": "boolean",
              "doc": "仕様範囲内かどうか（true: 合格 / false: 不合格）"
            }
          ]
        }
      },
      "default": [],
      "doc": "測定項目リスト（検査内容に応じて 0 件以上）"
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "発生日時（RFC 3339 / HLC タイムスタンプ文字列。wall clock 禁止）"
    },
    {
      "name": "pack_extensions",
      "type": {
        "type": "map",
        "values": "string"
      },
      "default": {},
      "doc": "pack が追加するカスタムフィールド（domain_event_envelope 拡張点。後方互換拡張のみ許可）"
    }
  ]
}
