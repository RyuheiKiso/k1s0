{
  "_comment": "purchase_order.approved.v1.avsc — 発注 aggregate の PurchaseOrder.Approved ドメインイベント Avro スキーマ",
  "_doc_ref": "docs/03_概要設計/03_tier2設計方針/10_表現手段.md §Avro スキーマ / aggregate split",
  "type": "record",
  "name": "PurchaseOrderApproved",
  "namespace": "io.k1s0.tier2.manufacturing.procurement.purchase_order.v1",
  "doc": "発注書（PurchaseOrder）が承認された（Approved）ドメインイベント。Placed イベントと同一 namespace を共有する。",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "イベント識別子（UUID v7 形式）"
    },
    {
      "name": "tenant_id",
      "type": "string",
      "doc": "テナント識別子（RLS 境界を保証する。AuthContext から取得する）"
    },
    {
      "name": "aggregate_id",
      "type": "string",
      "doc": "発注書 aggregate の識別子（UUID v7 形式）"
    },
    {
      "name": "aggregate_version",
      "type": "long",
      "doc": "楽観的ロック用 aggregate バージョン番号（Placed から単調増加）"
    },
    {
      "name": "approver_ids",
      "type": {
        "type": "array",
        "items": "string"
      },
      "doc": "承認者の識別子リスト（MultiApprover の場合は 2 件以上が必須）"
    },
    {
      "name": "approved_total_milli",
      "type": "long",
      "doc": "承認された発注合計金額（ミリ通貨単位）"
    },
    {
      "name": "currency_code",
      "type": "string",
      "doc": "通貨コード（ISO 4217 形式）"
    },
    {
      "name": "approval_note",
      "type": ["null", "string"],
      "default": null,
      "doc": "承認メモ（任意入力。PII が含まれる場合は field_pii annotation を付与し Outbox 書込時に redact する）"
    },
    {
      "name": "occurred_at",
      "type": "string",
      "doc": "発生日時（RFC 3339 / HLC タイムスタンプ文字列。wall clock 禁止）"
    },
    {
      "name": "pack_extensions",
      "type": {
        "type": "map",
        "values": "string"
      },
      "default": {},
      "doc": "pack が追加するカスタムフィールド（domain_event_envelope 拡張点。後方互換拡張のみ許可）"
    }
  ]
}
