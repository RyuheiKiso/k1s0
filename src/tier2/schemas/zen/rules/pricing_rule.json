{
  "description": "ZEN Engine DSL による価格ルール定義（設計方針 10 / 表現手段）",
  "contentType": "application/vnd.gorules.decision",
  "nodes": [
    {
      "id": "input_node",
      "type": "inputNode",
      "name": "RequestInput",
      "description": "価格計算リクエストの入力ノード（quantity フィールドを参照する）"
    },
    {
      "id": "rule_node",
      "type": "decisionTableNode",
      "name": "QuantityDiscountTable",
      "description": "数量に基づく割引率決定テーブル（quantity > 100 なら割引を適用する）",
      "content": {
        "hitPolicy": "FIRST",
        "inputs": [
          {
            "field": "quantity",
            "name": "数量",
            "description": "注文数量（割引判定の基底値）"
          }
        ],
        "outputs": [
          {
            "field": "discount_rate",
            "name": "割引率",
            "description": "適用する割引率（0.0〜1.0）"
          },
          {
            "field": "discount_applied",
            "name": "割引適用フラグ",
            "description": "割引が適用された場合は true"
          }
        ],
        "rules": [
          {
            "description": "数量が 100 超の場合は 10% 割引を適用する",
            "_id": "rule_high_quantity",
            "quantity": "> 100",
            "discount_rate": "0.1",
            "discount_applied": "true"
          },
          {
            "description": "数量が 100 以下の場合は割引なし",
            "_id": "rule_normal_quantity",
            "quantity": "<= 100",
            "discount_rate": "0.0",
            "discount_applied": "false"
          }
        ]
      }
    },
    {
      "id": "output_node",
      "type": "outputNode",
      "name": "PriceResult",
      "description": "価格計算結果の出力ノード（discount_rate と discount_applied を返す）"
    }
  ],
  "edges": [
    {
      "id": "edge_input_to_rule",
      "type": "edge",
      "sourceId": "input_node",
      "targetId": "rule_node"
    },
    {
      "id": "edge_rule_to_output",
      "type": "edge",
      "sourceId": "rule_node",
      "targetId": "output_node"
    }
  ]
}
