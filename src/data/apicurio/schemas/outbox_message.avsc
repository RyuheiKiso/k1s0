{
  "type": "record",
  "name": "OutboxMessage",
  "namespace": "io.k1s0.data.outbox",
  "doc": "Transactional Outbox パターンのメッセージスキーマ。Debezium CDC が Kafka に配信する際の形式。",
  "fields": [
    {
      "name": "message_id",
      "type": "string",
      "doc": "Outbox メッセージの一意識別子。UUID v4 形式。"
    },
    {
      "name": "event_id",
      "type": "string",
      "doc": "対応する domain_event の識別子。UUID 形式。"
    },
    {
      "name": "tenant_id",
      "type": "string",
      "doc": "テナント識別子。UUID 形式。メッセージルーティングに使用する。"
    },
    {
      "name": "topic",
      "type": "string",
      "doc": "送信先 Kafka トピック名。イベント種別に応じてルーティングされる。"
    },
    {
      "name": "partition_key",
      "type": "string",
      "doc": "Kafka パーティションキー。集約 ID を使用して順序保証する。"
    },
    {
      "name": "payload",
      "type": "bytes",
      "doc": "Avro シリアライズ済みのイベントペイロード。バイナリ形式。"
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      },
      "doc": "メッセージ作成時刻。マイクロ秒単位の UNIX タイムスタンプ。"
    },
    {
      "name": "retry_count",
      "type": "int",
      "default": 0,
      "doc": "送信試行回数。上限超過時にデッドレターキューへ移動する。"
    },
    {
      "name": "schema_version",
      "type": "string",
      "doc": "ペイロードのスキーマバージョン。Apicurio Registry の subject version。"
    }
  ]
}
